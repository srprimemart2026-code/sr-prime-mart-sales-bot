{
  "manifest_version": 3,
  "name": "S.R. PRIME MART - AI Auto Reply Bot",
  "version": "1.0.0",
  "description": "Facebook Marketplace ও Page ইনবক্সের লাইভ মেসেজ পড়ে Gemini AI দিয়ে অটো রিপ্লাই দেওয়ার বট।",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://www.messenger.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "S.R. PRIME MART AI Bot"
  },
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/*", "https://www.messenger.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
